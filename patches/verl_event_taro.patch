# Event-TARO patch for verl v0.7.1
#
# This patch modifies only upstream verl files.
# Event-TARO's new source files should be copied separately before/after applying:
#   sources/taro_event_manager.py -> verl/experimental/agent_loop/taro_event_manager.py
#   sources/taro_event_online.py  -> verl/trainer/ppo/taro_event_online.py
#
# Apply from the root of a clean verl v0.7.1 checkout:
#   git apply --check /path/to/verl_event_taro.patch
#   git apply /path/to/verl_event_taro.patch
#
--- a/verl/trainer/ppo/ray_trainer.py
+++ b/verl/trainer/ppo/ray_trainer.py
@@ -64,6 +64,7 @@
 from verl.utils.tracking import ValidationGenerationsLogger
 from verl.workers.config import FSDPEngineConfig
 from verl.workers.utils.padding import left_right_2_no_padding, no_padding_2_padding
+from verl.trainer.ppo.taro_event_online import taro_generate_step
 
 
 def apply_kl_penalty(data: DataProto, kl_ctrl: core_algos.AdaptiveKLController, kl_penalty="kl"):
@@ -1318,13 +1319,29 @@
                     with marked_timer("gen", timing_raw, color="red"):
                         if curr_step_profile:
                             self.async_rollout_manager.start_profile()
-                        gen_batch_output = self.async_rollout_manager.generate_sequences(gen_batch_output)
+                        taro_cfg = self.config.trainer.get("taro_online", {})
+                        taro_enabled = bool(
+                            taro_cfg.get("enabled", False)
+                        )
+
+                        if taro_enabled:
+                            batch, taro_metrics = taro_generate_step(
+                                trainer=self,
+                                batch=batch,
+                                gen_batch=gen_batch,
+                            )
+                            metrics.update(taro_metrics)
+                        else:
+                            gen_batch_output = self.async_rollout_manager.generate_sequences(
+                                gen_batch_output
+                            )
                         self.checkpoint_manager.sleep_replicas()
                         if curr_step_profile:
                             self.async_rollout_manager.stop_profile()
 
-                        timing_raw.update(gen_batch_output.meta_info["timing"])
-                        gen_batch_output.meta_info.pop("timing", None)
+                        if not taro_enabled:
+                            timing_raw.update(gen_batch_output.meta_info["timing"])
+                            gen_batch_output.meta_info.pop("timing", None)
 
                     if self.config.algorithm.adv_estimator == AdvantageEstimator.REMAX:
                         with marked_timer("gen_max", timing_raw, color="purple"):
@@ -1356,7 +1373,10 @@
                             del rm_scores, gen_baseline_batch, gen_baseline_output
                     # repeat to align with repeated responses in rollout
                     batch = batch.repeat(repeat_times=self.config.actor_rollout_ref.rollout.n, interleave=True)
-                    batch = batch.union(gen_batch_output)
+                    if not taro_enabled:
+                        batch = batch.union(
+                            gen_batch_output
+                        )
 
                     if "response_mask" not in batch.batch.keys():
                         batch.batch["response_mask"] = compute_response_mask(batch)
